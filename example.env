# ==============================================================================
# LinkedIn Banner Generator - Environment Configuration Template
# ==============================================================================
# Copy this file to 'local.env' or 'env.local' to customize your banner generation:
#   cp example.env local.env
#   # or
#   cp example.env env.local
#
# Note: 'local.env' and 'env.local' are git-ignored and will not be committed to GitHub.
# ==============================================================================

# Website URL displayed on the banner (leave blank to omit)
# Example: https://portfolio.dev or yourdomain.com
WEBSITE_URL=https://yourdomain.com

# Contact email displayed on the banner (leave blank to omit)
# Example: hello@yourdomain.com
EMAIL=hello@yourdomain.com

# Default banner preset name to generate when running without preset arguments
# Available presets:
#   - backend          (Backend & Distributed Systems)
#   - fullstack        (Full-Stack Software Engineer)
#   - ai_ml            (AI & Machine Learning Engineer)
#   - devops           (Cloud & DevOps / SRE)
#   - mobile           (Mobile Software Engineer)
#   - data_analyst     (Data Analyst)
#   - data_scientist   (Data Scientist)
#   - data_engineer    (Data Engineer)
#   - ai_engineer      (AI Engineer)
#   - ml_engineer      (Machine Learning Engineer)
#   - mlops_engineer   (MLOps Engineer)
#   - all              (Generate all presets)
BANNER_NAME=backend

# Theme & Background Style (exported to exported/<theme>/)
# Sets the default theme. Can be configured using THEME or BACKGROUND.
# Available options (can be selected with or without category prefix):
#
# Built-in base themes:
#   - linkedin              (Official LinkedIn platform UI blue #0A66C2 with white cards & brand geometry)
#   - network_nodes         (Deep navy constellation network mesh & interconnected graph nodes)
#   - dark                  (Deep slate & dark blue gradient)
#   - light                 (Crisp white & pale slate gradient)
#
# 1. Pattern & Topography Themes (assets/backgrounds/patterns/):
#   - linkedin              (Official LinkedIn brand blue #0A66C2, geometric facets, dynamic career arcs)
#   - network_nodes         (Deep navy interconnected graph nodes & constellation mesh)
#   - topographical         (Dark elevation contour map with glowing isolines)
#   - topographical_light   (Minimalist clean white/slate GIS elevation contour relief)
#   - topographical_pastel  (Vibrant pastel gradient with multi-tone elevation contours)
#   - topographical_dense   (High-density alpine relief terrain contour lines)
#   - grid_matrix           (Technical blueprint dot matrix with crosshairs)
#   - circuit_board         (Silicon microchip tracks and bus lines)
#   - flowing_waves         (Parametric sine wave ribbon lines)
#
# 2. Pastel Gradient Themes (assets/backgrounds/gradients/):
#   - pastel_aurora         (Vibrant aurora borealis pastel glow)
#   - pastel_mesh           (Multi-point pastel mesh gradient)
#   - pastel_sunset         (Warm apricot, peach and soft rose glow)
#   - pastel_mint           (Pastel neo-mint and seafoam green with subtle grid)
#   - pastel_geometry       (Pastel gradient with floating modern vector geometry)
#
# 3. Solid Pastel Themes (assets/backgrounds/solids/):
#   - solid_lavender        (Soft soothing light lavender/lilac #F3E8FF)
#   - solid_blush           (Delicate soft rose blush #FCE7F3)
#   - solid_peach           (Warm light apricot peach #FFEDD5)
#   - solid_cream           (Gentle vanilla cream #FEFCE8)
#   - solid_mint            (Fresh sage & pastel neo-mint #ECFDF5)
#   - solid_sky             (Serene baby sky blue #F0F9FF)
#   - solid_periwinkle      (Crisp light periwinkle ice #EEF2FF)
#   - solid_sand            (Warm minimalist neutral linen #FAFAF9)
THEME=topographical

# Background Pattern Fade / Opacity (percentage or float: e.g. 40%, 60%, 100%, 0.5)
# Controls the subtle fade / opacity of pattern contour lines and grid overlays.
# Default: 100% (or 1.0)
FADE=100%

# ------------------------------------------------------------------------------
# Fine-Grained Custom Banner Specification (Design Standards Enforced)
# ------------------------------------------------------------------------------
# You can craft custom banners by setting BANNER_NAME=custom or by defining:
#
# Custom role title (3-45 chars, e.g. 'Lead Cloud Architect'):
# TITLE=Lead Cloud Architect
#
# Custom subtitle / tagline (3-80 chars):
# SUBTITLE=Cloud Native • Kubernetes • Terraform • Distributed Systems
#
# Custom tech stack icons (3-8 icons, comma-separated names or aliases):
# Guidelines & Limits:
#   - Min 3 icons (ensures visual balance)
#   - Max 8 icons (protects LinkedIn profile avatar safe zone without clipping)
# Available names: python, golang, rust, k8s, docker, aws, gcp, react, nextjs, etc.
# ICONS=golang, kubernetes, terraform, aws, docker, python
